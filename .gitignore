# secrets: never commit real keys (.env.example is the template)
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# regenerable caches (python scripts/... rebuilds them; chunk JSONs are kept
# because the README points at them)
data/emb_*.npy
data/emb_*.sig


# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# docs/claude-session.jsonl is committed on purpose (brief, section 12). Review
# it for secrets before every push; only backups and scratch exports stay local.
*.jsonl.bak
docs/*.tmp
docs/*.bak

# my own manual test runs against the real API (not part of the reported results)
logs/*mytest*

# files CI and local tooling create (CI writes ci-requirements.txt; the figure
# is regenerated by make_tables.py and committed on purpose, so it is not ignored)
ci-requirements.txt
.coverage
htmlcov/
act/
*.log.tmp
